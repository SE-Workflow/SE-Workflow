# =====================================================================
# SE Workflow Studio · LLM 配置模板
#
# 使用方式：
#   1. 复制本文件为 .env：copy .env.example .env
#   2. 填入自己的 API Key（不要提交 .env 到仓库）
#   3. 重启服务：python app.py
#
# .env 已在 .gitignore 中忽略；网页只显示掩码后的 Key。
# =====================================================================

# ---------- 必填 ----------
# 你的 API Key（不要加引号之外的空格）
LLM_API_KEY=

# 兼容 OpenAI 风格的 base_url（通常以 /v1 结尾）
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
LLM_MODEL=deepseek-chat

# ---------- 可选（有默认值） ----------
# 采样温度：0 更稳定，0.2-0.5 适合结构化生成
LLM_TEMPERATURE=0.2

# 单次请求超时（秒）
LLM_TIMEOUT=90

# 阶段 JSON 解析/校验失败后的纠错重试次数（不含首次调用）
LLM_MAX_RETRIES=2

# LLM 调用失败时是否允许自动回退到 Mock 规则演示
LLM_ALLOW_MOCK=true

# 强制使用 Mock（true 时不发起任何网络请求，适合离线演示）
LLM_MOCK_MODE=false

# 是否向接口发送 response_format={"type":"json_object"}；
# 服务商不支持时客户端会自动去掉该参数重试，一般无需修改
LLM_JSON_MODE=true

# ---------- Web 服务 ----------
HOST=127.0.0.1
PORT=5000

# =====================================================================
# 常见服务商配置示例（按需替换上方三项）
#
# OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#
# DeepSeek:
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
#
# Moonshot:
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_MODEL=moonshot-v1-8k
#
# 通义千问（DashScope 兼容模式）:
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
#
# 本地 Ollama（OpenAI 兼容）:
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=qwen2.5:7b
#   LLM_API_KEY=ollama
# =====================================================================
